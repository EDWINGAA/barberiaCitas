# ============================================================
#  MODO FIREBASE REAL
#
#  Vite carga primero .env y luego este, que solo pisa el
#  interruptor. Las credenciales siguen viviendo unicamente en
#  .env, que git ignora.
#
#  Uso:   npm run dev:firebase
#         npm run build:firebase
# ============================================================
VITE_USE_MOCK=false
