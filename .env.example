# ============================================================
#  MODO DEMO
#  true  -> la app usa los servicios mock (memoria + localStorage).
#           No necesitas Firebase para nada. Es el valor por defecto.
#  false -> la app usa Firebase real (Auth + Firestore + Storage).
# ============================================================
VITE_USE_MOCK=true

# ============================================================
#  CREDENCIALES DE FIREBASE
#  Solo son necesarias cuando VITE_USE_MOCK=false.
#  Las obtienes en: Firebase Console > Configuracion del proyecto >
#  Tus apps > App web > Configuracion del SDK.
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
